generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  userAnswers  UserAnswer[]
  mockExams    MockExam[]
  codeSubmissions CodeSubmission[]
  gameProfile     GameProfile?
}

model Question {
  id            String   @id @default(cuid())
  session       String
  level         Int
  type          String
  questionIndex Int
  questionText  String
  options       Json?
  answer        String?
  explanation   String?
  topics        String[]
  difficulty    String?  @default("medium")
  images        Json?
  codeBlocks    Json?
  inputFormat   String?
  outputFormat  String?
  constraints   String?
  sampleInput   String?
  sampleOutput  String?
  templateCode  String?
  testCases     Json?
  createdAt     DateTime @default(now())
  userAnswers     UserAnswer[]
  mockExamAnswers MockExamAnswer[]
  codeSubmissions CodeSubmission[]

  @@unique([session, level, questionIndex])
  @@index([level, type, session])
}

model UserAnswer {
  id          String   @id @default(cuid())
  userId      String
  questionId  String
  userAnswer  String
  isCorrect   Boolean
  timeSpentMs Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, questionId])
  @@index([userId, isCorrect])
}

model MockExam {
  id          String            @id @default(cuid())
  userId      String
  level       Int
  startedAt   DateTime
  completedAt DateTime?
  timeLimit   Int
  status      String            @default("in_progress")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     MockExamAnswer[]
}

model MockExamAnswer {
  id          String     @id @default(cuid())
  mockExamId  String
  questionId  String
  userAnswer  String?
  isCorrect   Boolean?
  mockExam    MockExam   @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  question    Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model CodeSubmission {
  id              String    @id @default(cuid())
  userId          String
  questionId      String
  code            String
  language        String    @default("python")
  status          String    @default("pending")
  stdout          String?
  stderr          String?
  executionTimeMs Int?
  memoryUsedKb    Int?
  testResults     Json?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question        Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model GameProfile {
  id              String          @id @default(cuid())
  userId          String          @unique
  nickname        String
  avatar          String          @default("🐱")
  totalXP         Int             @default(0)
  level           Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageProgresses StageProgress[]
  achievements    UserAchievement[]
  storyProgresses StoryProgress[]
}

model Stage {
  id              String         @id @default(cuid())
  level           Int
  stageIndex      Int
  title           String
  description     String?
  type            String         @default("normal")
  questionCount   Int            @default(5)
  timeLimit       Int?
  requiredScore   Float          @default(0.8)
  createdAt       DateTime       @default(now())
  stageProgresses StageProgress[]

  @@unique([level, stageIndex])
}

model StageProgress {
  id          String      @id @default(cuid())
  userId      String
  stageId     String
  status      String      @default("locked")
  stars       Int         @default(0)
  bestScore   Float?
  attempts    Int         @default(0)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  gameProfile GameProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  stage       Stage       @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([userId, stageId])
}

model Achievement {
  id              String           @id @default(cuid())
  key             String           @unique
  name            String
  description     String
  icon            String
  condition       Json
  createdAt       DateTime         @default(now())
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  gameProfile   GameProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model LeaderboardEntry {
  id         String   @id @default(cuid())
  userId     String   @unique
  totalScore Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model StoryChapter {
  id              String         @id @default(cuid())
  level           Int
  chapterIndex    Int
  title           String
  scenes          Json
  createdAt       DateTime       @default(now())
  storyProgresses StoryProgress[]

  @@unique([level, chapterIndex])
}

model StoryProgress {
  id            String        @id @default(cuid())
  userId        String
  chapterId     String
  currentScene  Int           @default(0)
  completed     Boolean       @default(false)
  completedAt   DateTime?
  gameProfile   GameProfile   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  chapter       StoryChapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}
